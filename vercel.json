{
  "redirects": [
    {
      "source": "/josephine-memorial.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/remembrance",
      "destination": "/remembrance.html"
    }
  ]
}
